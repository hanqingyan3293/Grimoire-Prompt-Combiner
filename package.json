{
    "name": "grimoire",
    "version": "7.1.0",
    "description": "魔导书 Grimoire v7 — AI提示词组合器 / AI Prompt Combiner",
    "main": "dist/main/main/index.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
        "dev:renderer": "vite",
        "dev:electron": "wait-on http://localhost:5173 && electron .",
        "build:renderer": "vite build",
        "build:main": "tsc -p tsconfig.node.json",
        "build": "npm run build:renderer && npm run build:main && node -e \"require('fs').cpSync('data/tags.json','dist/main/data/tags.json',{recursive:true})\"",
        "start": "electron .",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "pack:portable": "npm run build && electron-builder --win portable",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "grimoire",
        "prompt-combiner",
        "ai-art",
        "novelai",
        "stable-diffusion"
    ],
    "author": "hanqingyan3293",
    "license": "GPL-3.0",
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@ant-design/pro-components": "^3.0.0-beta.3",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@tanstack/react-query": "^5.102.8",
        "@uiw/react-codemirror": "^4.25.11",
        "antd": "^6.6.3",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.23",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "gpt-tokenizer": "^3.4.0",
        "i18next": "^26.4.2",
        "localforage": "^1.10.0",
        "lucide-react": "^1.41.0",
        "motion": "^12.43.0",
        "nanoid": "^5.1.16",
        "openai": "^6.42.0",
        "radix-ui": "^1.6.7",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-i18next": "^17.0.13",
        "react-markdown": "^10.1.0",
        "react-router": "^7.18.3",
        "react-router-dom": "^7.18.3",
        "remark-gfm": "^4.0.1",
        "sql.js": "^1.14.1",
        "streamdown": "^2.6.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/file-saver": "^2.0.7",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/sql.js": "^1.4.11",
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^10.0.3",
        "electron": "^42.4.0",
        "electron-builder": "^26.15.2",
        "jsdom": "^26.1.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^3.2.0",
        "wait-on": "^9.0.10"
    },
    "build": {
        "productName": "Grimoire",
        "appId": "com.grimoire.prompt-combiner",
        "copyright": "GPL-3.0 License",
        "directories": {
            "output": "release",
            "buildResources": "resources"
        },
        "files": [
            "dist/**/*",
            "data/tags.json",
            "THIRD_PARTY_NOTICES.md"
        ],
        "extraResources": [
            {
                "from": "python",
                "to": "python",
                "filter": [
                    "wd14_worker.py",
                    "wd14_tagger.py",
                    "requirements.txt"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icons/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "shortcutName": "Grimoire"
        },
        "extraMetadata": {
            "main": "dist/main/main/index.js"
        }
    }
}
