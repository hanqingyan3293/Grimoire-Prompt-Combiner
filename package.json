{
    "name":  "grimoire",
    "version":  "7.0.0",
    "description":  "魔导书 Grimoire v7 — AI提示词组合器 / AI Prompt Combiner",
    "main":  "dist/main/main/index.js",
    "scripts":  {
                    "dev":  "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
                    "dev:renderer":  "vite",
                    "dev:electron":  "wait-on http://localhost:5173 \u0026\u0026 electron .",
                    "build:renderer":  "vite build",
                    "build:main":  "tsc -p tsconfig.node.json",
                    "build":  "npm run build:renderer \u0026\u0026 npm run build:main \u0026\u0026 node -e \"require(\u0027fs\u0027).cpSync(\u0027data/tags.json\u0027,\u0027dist/main/data/tags.json\u0027,{recursive:true})\"",
                    "start":  "electron .",
                    "pack":  "npm run build \u0026\u0026 electron-builder --dir",
                    "dist":  "npm run build \u0026\u0026 electron-builder",
                    "pack:portable":  "npm run build \u0026\u0026 electron-builder --win portable",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                },
    "keywords":  [
                     "grimoire",
                     "prompt-combiner",
                     "ai-art",
                     "novelai",
                     "stable-diffusion"
                 ],
    "author":  "hanqingyan3293",
    "license":  "GPL-3.0",
    "dependencies":  {
                         "react":  "^19.1.0",
                         "react-dom":  "^19.1.0",
                         "zustand":  "^5.0.14",
                         "sql.js":  "^1.14.1",
                         "react-markdown":  "^10.1.0",
                         "remark-gfm":  "^4.0.1"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.3.0",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@types/sql.js":  "^1.4.11",
                            "@vitejs/plugin-react":  "^6.0.2",
                            "concurrently":  "^10.0.3",
                            "electron":  "^42.4.0",
                            "electron-builder":  "^26.15.2",
                            "tailwindcss":  "^4.3.0",
                            "typescript":  "^6.0.3",
                            "vite":  "^8.0.16",
                            "vitest":  "^3.2.0",
                            "wait-on":  "^9.0.10",
                            "@testing-library/react":  "^16.3.0",
                            "@testing-library/jest-dom":  "^6.6.3",
                            "jsdom":  "^26.1.0"
                        },
    "build":  {
                  "productName":  "Grimoire",
                  "appId":  "com.grimoire.prompt-combiner",
                  "copyright":  "GPL-3.0 License",
                  "directories":  {
                                      "output":  "release",
                                      "buildResources":  "resources"
                                  },
                  "files":  [
                                "dist/**/*",
                                "data/tags.json"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "resources/icons/icon.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "shortcutName":  "Grimoire"
                           },
                  "extraMetadata":  {
                                        "main":  "dist/main/main/index.js"
                                    }
              }
}